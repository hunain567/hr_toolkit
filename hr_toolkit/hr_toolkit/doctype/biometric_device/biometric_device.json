 "fields": [
  {
   "fieldname": "device_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Device Name",
   "reqd": 1,
   "unique": 1
  },
  {
   "default": "1",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Enabled"
  },
  {
   "description": "e.g. Main Gate, Production Hall",
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Location"
  },
  {
   "fieldname": "column_break_general",
   "fieldtype": "Column Break"
  },
  {
   "default": "AUTO",
   "description": "AUTO: log type is left empty (set by Shift Type or your own scripts). IN / OUT: every punch from this device gets that log type. Device Punch State: uses the IN/OUT key pressed on the device.",
   "fieldname": "punch_direction",
   "fieldtype": "Select",
   "label": "Punch Direction",
   "options": "AUTO\nIN\nOUT\nDevice Punch State",
   "reqd": 1
  },
  {
   "description": "Punches before this date are ignored on the first sync. Leave empty to import everything stored on the device.",
   "fieldname": "import_from_date",
   "fieldtype": "Date",
   "label": "Import Punches From"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.connection_mode!='Push (ADMS)'",
   "description": "Keep a live connection to the device so each punch becomes an Employee Checkin within seconds. Requires the Biometric Live Listener service on the server. Scheduled syncs skip this device; the listener imports missed punches itself on every reconnect.",
   "fieldname": "real_time_capture",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Real-time (Live Capture)"
  },
  {
   "fieldname": "section_connection",
   "fieldtype": "Section Break",
   "label": "Connection"
  },
  {
   "default": "Pull (TCP/IP)",
   "description": "Push (ADMS): the device sends every punch to ERPNext immediately (real time). Pull (TCP/IP): ERPNext reads punches from the device at the sync interval.",
   "fieldname": "connection_mode",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Connection Mode",
   "options": "Pull (TCP/IP)\nPush (ADMS)",
   "reqd": 1
  },
  {
   "description": "Required for Push (ADMS). Shown on the device under System Info / Device Info.",
   "fieldname": "serial_number",
   "fieldtype": "Data",
   "label": "Serial Number",
   "mandatory_depends_on": "eval:doc.connection_mode=='Push (ADMS)'",
   "no_copy": 1,
   "unique": 1
  },
  {
   "description": "Pull: the device IP to connect to. Push: optional, when set only requests from this IP are accepted.",
   "fieldname": "ip_address",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "IP Address",
   "mandatory_depends_on": "eval:doc.connection_mode=='Pull (TCP/IP)'"
  },
  {
   "default": "4370",
   "depends_on": "eval:doc.connection_mode=='Pull (TCP/IP)'",
   "fieldname": "port",
   "fieldtype": "Int",
   "label": "Port"
  },
  {
   "fieldname": "column_break_connection",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.connection_mode=='Push (ADMS)'",
   "fieldname": "push_setup_help",
   "fieldtype": "HTML",
   "label": "Push Setup Help"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.connection_mode=='Pull (TCP/IP)'",
   "description": "Device menu: Comm. / Communication settings. Usually 0.",
   "fieldname": "comm_password",
   "fieldtype": "Int",
   "label": "Communication Key"
  },
  {
   "default": "30",
   "depends_on": "eval:doc.connection_mode=='Pull (TCP/IP)'",
   "fieldname": "timeout",
   "fieldtype": "Int",
   "label": "Timeout (Seconds)"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.connection_mode=='Pull (TCP/IP)'",
